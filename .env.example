# Adresse deines OpenCode-Servers (lokal mit `opencode serve --port 4096`)
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Passwort, das der OpenCode-Server beim Start in der Konsole ausgibt
# ("server password …"). Auth erfolgt per Basic Auth (Benutzer "opencode").
OPENCODE_PASSWORD=

# Arbeitsverzeichnis für die Sessions: ABSOLUTER Pfad auf dem Server-Rechner.
# Wenn leer, nutzt der Server sein Standard-Verzeichnis.
# Beispiel (Windows): C:\opencode\workspace
# Beispiel (Linux):   /home/user/opencode-workspace
OPENCODE_WORKSPACE=